package com.example.backend.service;

import com.example.backend.entity.Product;
import com.example.backend.repository.ProductRepository;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

@Service
public class ProductService {

    private final ProductRepository repository;


    public ProductService(
            ProductRepository repository) {

        this.repository = repository;
    }


    // ================================
    // ADD PRODUCT
    // ================================

    public Product addProduct(Product product) {

        product.setRequestStatus("NONE");

        product.setRequestedQuantity(0);

        product.setRequestedBy(null);

        product.setQuotationStatus("NONE");

        product.setSupplierName(null);

        product.setQuotationTotal(0.0);

        return repository.save(product);
    }


    // ================================
    // GET ALL PRODUCTS
    // ================================

    public List<Product> getAllProducts() {

        return repository.findAll();
    }


    // ================================
    // GET PRODUCT
    // ================================

    public Product getProduct(Long id) {

        return repository
                .findById(id)
                .orElse(null);
    }


    // ================================
    // UPDATE PRODUCT
    // ================================

    public Product updateProduct(
            Long id,
            Product product) {

        Product existing =
                repository
                        .findById(id)
                        .orElse(null);

        if (existing == null) {
            return null;
        }

        existing.setProductName(
                product.getProductName()
        );

        existing.setPrice(
                product.getPrice()
        );

        existing.setQuantity(
                product.getQuantity()
        );

        return repository.save(existing);
    }


    // ================================
    // SAVE PRODUCT
    // ================================

    public Product saveProduct(
            Product product) {

        return repository.save(product);
    }


    // ================================
    // DELETE PRODUCT
    // ================================

    public void deleteProduct(Long id) {

        repository.deleteById(id);
    }


    // ================================
    // CONFIRM PURCHASE REQUEST
    // ================================

    @Transactional
    public Product confirmRequest(Long id) {

        int updatedRows =
                repository.confirmRequest(id);

        if (updatedRows == 0) {

            throw new RuntimeException(
                    "Request cannot be confirmed"
            );
        }

        return repository
                .findById(id)
                .orElseThrow(() ->
                        new RuntimeException(
                                "Product not found"
                        )
                );
    }


    // ================================
    // REJECT PURCHASE REQUEST
    // ================================

    @Transactional
    public Product rejectRequest(Long id) {

        int updatedRows =
                repository.rejectRequest(id);

        if (updatedRows == 0) {

            throw new RuntimeException(
                    "Request cannot be rejected"
            );
        }

        return repository
                .findById(id)
                .orElseThrow(() ->
                        new RuntimeException(
                                "Product not found"
                        )
                );
    }


    // ================================
    // CONFIRM QUOTATION
    // ================================

    public Product confirmQuotation(
            Long id,
            String supplierName) {

        Product product =
                repository
                        .findById(id)
                        .orElse(null);


        if (product == null) {

            throw new RuntimeException(
                    "Product not found"
            );
        }


        if (product.getRequestedQuantity() <= 0) {

            throw new RuntimeException(
                    "No requested quantity found"
            );
        }


        if (supplierName == null ||
                supplierName.trim().isEmpty()) {

            throw new RuntimeException(
                    "Supplier is required"
            );
        }


        double totalAmount =
                product.getPrice()
                        *
                product.getRequestedQuantity();


        product.setSupplierName(
                supplierName
        );


        product.setQuotationTotal(
                totalAmount
        );


        product.setQuotationStatus(
                "CONFIRMED"
        );


        return repository.save(product);
    }
}