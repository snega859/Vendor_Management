package com.example.backend.controller;

import java.util.List;

import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.example.backend.entity.Product;
import com.example.backend.service.ProductService;

@RestController
@RequestMapping("/api/products")
@CrossOrigin(origins = "http://localhost:5173")
public class ProductController {

    private final ProductService service;

    public ProductController(ProductService service) {
        this.service = service;
    }

    // Add product
    @PostMapping
    public Product add(@RequestBody Product product) {

        return service.addProduct(product);
    }

    // Get all products
    @GetMapping
    public List<Product> getAll() {

        return service.getAllProducts();
    }

    // Get one product
    @GetMapping("/{id}")
    public Product getOne(@PathVariable Long id) {

        return service.getProduct(id);
    }

    // Update product
    @PutMapping("/{id}")
    public Product update(
            @PathVariable Long id,
            @RequestBody Product product) {

        return service.updateProduct(id, product);
    }

    // Delete product
    @DeleteMapping("/{id}")
    public String delete(@PathVariable Long id) {

        service.deleteProduct(id);

        return "Product deleted successfully";
    }


    // ================================
    // USER PLACE PURCHASE REQUEST
    // ================================

    @PutMapping("/{id}/request")
    public Product placeRequest(
            @PathVariable Long id,
            @RequestBody Product request) {

        Product product = service.getProduct(id);

        if (request.getRequestedQuantity() <= 0) {

            throw new RuntimeException(
                    "Please enter a valid quantity");
        }

        if (request.getRequestedQuantity()
                > product.getQuantity()) {

            throw new RuntimeException(
                    "Requested quantity is not available");
        }

        product.setRequestedQuantity(
                request.getRequestedQuantity());

        product.setRequestedBy(
                request.getRequestedBy());

        product.setRequestStatus("PENDING");

        return service.updateProduct(id, product);
    }


    // ================================
    // ADMIN CONFIRM REQUEST
    // ================================

    @PutMapping("/{id}/confirm")
    public Product confirmRequest(
            @PathVariable Long id) {

        Product product = service.getProduct(id);

        if (!"PENDING".equals(
                product.getRequestStatus())) {

            throw new RuntimeException(
                    "No pending request");
        }

        if (product.getRequestedQuantity()
                > product.getQuantity()) {

            throw new RuntimeException(
                    "Not enough quantity available");
        }

        // Reduce quantity only now
        product.setQuantity(
                product.getQuantity()
                        - product.getRequestedQuantity());

        product.setRequestStatus("APPROVED");

        return service.updateProduct(id, product);
    }


    // ================================
    // ADMIN REJECT REQUEST
    // ================================

    @PutMapping("/{id}/reject")
    public Product rejectRequest(
            @PathVariable Long id) {

        Product product = service.getProduct(id);

        product.setRequestStatus("REJECTED");

        return service.updateProduct(id, product);
    }
}